generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  COMMITTEE
}

enum UserStatus {
  ACTIVE
  WARNED
  SUSPENDED
  BANNED
}

enum WordStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ModerationAction {
  WARNING
  SUSPEND_24H
  SUSPEND_10D
  BAN
}

enum NotificationType {
  WORD_APPROVED
  WORD_REJECTED
  WARNING
  SUSPENSION
  BAN
  GENERAL
}

enum AuditAction {
  APPROVE_WORD
  REJECT_WORD
  DELETE_WORD
  SUSPEND_USER
  UNSUSPEND_USER
  BAN_USER
  UNBAN_USER
  WARN_USER
  CHANGE_SETTING
  CHANGE_USER_ROLE
  DELETE_USER
  RENAME_USER
}

enum AuditTargetType {
  USER
  WORD
  SETTING
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// App models
model User {
  id                 String     @id @default(cuid())
  serialNumber       Int        @unique @default(autoincrement())
  name               String?
  email              String     @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  firstName          String     @default("")
  lastName           String     @default("")
  fullName           String     @default("")
  age                Int        @default(0)
  role               UserRole   @default(USER)
  status             UserStatus @default(ACTIVE)
  warningCount       Int        @default(0)
  suspendedUntil     DateTime?
  termsAcceptedAt    DateTime?
  dailySubmissions   Int        @default(0)
  lastSubmissionDate DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  accounts           Account[]
  sessions           Session[]
  submittedWords     Word[]          @relation("SubmittedWords")
  reviewedWords      Word[]          @relation("ReviewedWords")
  moderationLogs     ModerationLog[]
  notifications      Notification[]
  wordSessions       WordSession[]
  adminAuditLogs     AdminAuditLog[]
  submittedSentences Sentence[]      @relation("SubmittedSentences")
  reviewedSentences  Sentence[]      @relation("ReviewedSentences")
}

model Word {
  id             Int        @id @default(autoincrement())
  word           String     @unique
  meaning        String
  startingLetter String
  status         WordStatus @default(PENDING)
  submittedById  String?
  reviewedById   String?
  reviewNote     String?
  submissionTime Int
  sessionToken   String?
  // Permanent credit fields - never change even if user is deleted
  submitterName  String     @default("")
  submitterEmail String     @default("")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  submittedBy   User?          @relation("SubmittedWords", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy    User?          @relation("ReviewedWords", fields: [reviewedById], references: [id], onDelete: SetNull)
  notifications Notification[]
}

model ModerationLog {
  id             String           @id @default(cuid())
  userId         String?
  wordAttempt    String
  meaningAttempt String
  reason         String
  actionTaken    ModerationAction
  createdAt      DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String?
  type      NotificationType
  title     String
  message   String
  wordId    Int?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  word Word? @relation(fields: [wordId], references: [id])
}

model AdminAuditLog {
  id         String          @id @default(cuid())
  adminId    String?
  action     AuditAction
  targetType AuditTargetType
  targetId   String
  details    Json?
  createdAt  DateTime        @default(now())

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)
}

model WordSession {
  id        String   @id @default(cuid())
  userId    String?
  letter    String
  startedAt DateTime @default(now())
  expiresAt DateTime
  used      Boolean  @default(false)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model LlmUsageLog {
  id            String   @id @default(cuid())
  model         String
  operation     String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  totalTokens   Int      @default(0)
  estimatedCost Float    @default(0)
  createdAt     DateTime @default(now())
}

model EmailLog {
  id            String   @id @default(cuid())
  to            String
  subject       String
  type          String   // e.g. "magic_link", "notification"
  estimatedCost Float    @default(0)
  createdAt     DateTime @default(now())
}

enum SentenceStatus {
  PENDING
  APPROVED
  REJECTED
}

// Community-written sentences using shakdol words
model Sentence {
  id            Int            @id @default(autoincrement())
  text          String         // The sentence in shakdol
  meaning       String         // What the sentence means in Hebrew
  wordsUsed     String[]       // Array of shakdol words used
  status        SentenceStatus @default(PENDING)
  submittedById String?
  reviewedById  String?
  reviewNote    String?
  likes         Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  submittedBy User? @relation("SubmittedSentences", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy  User? @relation("ReviewedSentences", fields: [reviewedById], references: [id], onDelete: SetNull)
}

// Grammar rules extracted by AI from community sentences
model GrammarRule {
  id          Int      @id @default(autoincrement())
  title       String   // Short rule name, e.g. "נטיית עבר"
  description String   // Full explanation
  examples    String[] // Example sentences demonstrating the rule
  category    String   // e.g. "נטיות", "תחביר", "מטאפורות"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
